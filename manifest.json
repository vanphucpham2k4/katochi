{
  "manifest_version": 3,
  "name": "KATOCHI",
  "version": "0.1.0",
  "description": "AI-powered browser extension for interactive website transformation",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Summon KATOCHI"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.ts"]
    }
  ]
}
